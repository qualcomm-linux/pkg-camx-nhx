Subject: camera-nhx: use arch triplet in camera-nhx path

Use /usr/libexec/aarch64-linux-gnu/camx-* to find the nativehaltest files

Signed-off-by: Chinmay Patil <chinpati@qti.qualcomm.com>
--- a/camx-nhx/arm64/usr/bin/camera-nhx
+++ b/camx-nhx/arm64/usr/bin/camera-nhx
@@ -103,7 +103,7 @@
         [ -z "${soc_ids}" ] && continue
         # Format SoC IDs for display
         display_ids=$(echo "${soc_ids}" | tr ',' ', ')
-        printf "  - %-30s -> /usr/libexec/camx-%s/nativehaltest\n" "${display_ids}" "${dir}"
+        printf "  - %-30s -> /usr/libexec/aarch64-linux-gnu/camx-%s/nativehaltest\n" "${display_ids}" "${dir}"
     done
 }
 
@@ -161,7 +161,7 @@
 
 # Parse configuration
 SOC_NAME="$(echo "${SOC_CONFIG}" | cut -d'|' -f1)"
-NHX_DIR="/usr/libexec/camx-$(echo "${SOC_CONFIG}" | cut -d'|' -f3)"
+NHX_DIR="/usr/libexec/aarch64-linux-gnu/camx-$(echo "${SOC_CONFIG}" | cut -d'|' -f3)"
 
 # Determine JSON file to use (argument overrides SoC default)
 if [ $# -eq 0 ]; then
